# ============================================
# oh-my-opensecret 配置示例
# ============================================
# 用法：
#   1. 复制此文件到项目根目录，重命名为 oh-my-opensecret.yaml
#   2. 按需修改配置项
#   3. 重启 Opencode 使配置生效
#
# 首次启动若无配置，插件会自动生成一份默认配置（结构与本文件一致，
# 但自定义 regex 一律是注释状态）。你随时修改 YAML 文件，下次启动自动生效。
#
# 配置查找优先级（从高到低）：
#   1. $OPENCODE_SECRET_CONFIG 环境变量指向的文件
#      （显式指定时只认这一个路径，不再回落下面几处）
#   2. 项目根目录下的 oh-my-opensecret.yaml
#   3. 项目根目录 .opencode/ 下的 oh-my-opensecret.yaml
#   4. 全局配置目录下的 oh-my-opensecret.yaml
#      （$OPENCODE_CONFIG_DIR → $XDG_CONFIG_HOME/opencode → ~/.config/opencode）
#   5. 以上都不存在则自动生成默认配置（生成到 $OPENCODE_SECRET_CONFIG
#      指定的路径，或全局配置目录）
#
# 配置校验为 fail-fast：字段非法（如 regex 写成字符串、ttl 格式错、
# 正则无法编译）会直接报错中止加载，不会静默套用默认值。
# ============================================


# ---------- 基本开关 ----------

# 是否启用插件。
#   true  — 启用脱敏/还原（默认）
#   false — 完全禁用，不注册任何 hook，插件成为 no-op
enabled: true


# ---------- 日志配置 ----------

# level:  输出级别 debug/info/warn/error（默认 info）
#   注意：写其它值（含 off）会被判为非法配置并中止加载。
# file:   日志文件路径（默认 ~/.oh-my-opensecret/oh-my-opensecret.log）
# rotation:
#   max_size:  滚动阈值（默认 "10m"，支持 500k/10m/1g）
#   max_files: 保留历史文件数（默认 7），超出删除最旧
# 滚动规则：文件大小超限或日期变更时触发。
# 历史文件名格式: oh-my-opensecret.2026-06-04.1.log
logging:
  level: info
  file: ~/.oh-my-opensecret/oh-my-opensecret.log
  # rotation:
  #   max_size: "10m"
  #   max_files: 7


# ---------- 自动发现 ----------

# 启动时自动扫描 Opencode 配置（opencode.json / opencode.jsonc），
# 从中提取 apiKey / token / secret / password 等敏感字段的值，
# 自动生成对应的正则规则并追加到配置文件中，
# 同时在 patterns: 之前写入一段扫描报告注释。
#
# 报告与新规则只含配置路径、覆盖状态、字符长度，不含任何原文片段。
# 已存在的同 placeholder-id 规则跳过，不覆盖现有配置。
# 报告块按行定位写回，每次启动幂等执行。
#
# 仅在 enabled: true 时生效。
auto_discovery: true


# ---------- 占位符 ----------

# 脱敏后占位符的前缀。
# 完整格式：{PREFIX}_{CATEGORY}_{hash12}__
# 例如：__OMOS_EMAIL_ab12cd34ef56__
# 自定义前缀时确保不含正则特殊字符。
placeholder_prefix: "__OMOS_"


# ---------- 占位符映射管理 ----------

# 占位符 ↔ 原文的映射关系按「整个 server 进程」维护：
# 一把随机 HMAC 密钥 + 一张映射表，密钥不出本机。
# 因此同一进程内同一个原文恒定映射到同一个占位符。
session:
  # 映射有效期（超过此时间的映射自动清理）。
  # 格式: 数字 + 单位 (ms/s/m/h/d)
  ttl: "1h"

  # 映射表容量上限。
  # 超过此上限时淘汰最久未使用的映射（LRU）。
  max_mappings: 100000


# ============================================
# 匹配规则
# ============================================
# patterns 下四个列表：keywords / regex / builtin / exclude
# 四者必须为数组；内置规则按名称从 src/patterns.js 的 BUILTIN 表引用。
# ============================================

patterns:

  # ---------- 关键词匹配（精确子串） ----------

  # 按原文精确子串匹配（非正则），适合固定的敏感词。
  # 例：防止项目中提及某个内部系统名
  # 未指定分类时，占位符类别回落为 TEXT
  keywords: []

  # ---------- 自定义正则规则 ----------

  # 每个规则两个字段：
  #   pattern:  正则表达式，支持 /regex/flags 字面量语法，
  #             如 "/[a-z]+/gi"，也支持 (?i)(?m)(?s) 内联前缀，两者可叠加。
  #             匹配时若未带 g 会被自动补上。
  #   placeholder-id: 分类名，用于占位符标识（仅用于日志和调试）
  #
  # 平台 API Key 一律不在内置规则里，需要在这里自行添加。
  # 下面的示例已生效，按需增删：
  regex:
    - pattern: "sk-[A-Za-z0-9]{48}"
      placeholder-id: "OPENAI_KEY"
    - pattern: "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]+"
      placeholder-id: "GITHUB_TOKEN"
    - pattern: "AKIA[0-9A-Z]{16}"
      placeholder-id: "AWS_ACCESS_KEY"

  # ---------- 内置规则列表 ----------
  #
  # 从下方列表中选择要启用的内置规则，按名称引用即可（共 9 条）。
  # 内置规则仅覆盖通用 PII，不包含任何平台 API Key。
  # API Key 请在上方 regex 中添加自定义规则。
  #
  # 可用内置规则：
  #   - email          邮箱地址
  #   - china_phone    中国大陆手机号
  #   - china_id       中国大陆身份证号
  #   - uuid           UUID（版本位 1-5）
  #   - ipv4           IPv4 地址
  #   - ipv6           IPv6 地址（仅全写 8 组形式，压缩写法不匹配）
  #   - mac            MAC 地址
  #   - jwt            JWT Token
  #   - db_connection  数据库连接串
  builtin:
    - email
    - china_phone
    - china_id
    - uuid
    - ipv4
    - ipv6
    - mac
    - jwt
    - db_connection

  # ---------- 排除列表（白名单/豁免） ----------

  # 此处列出的内容不会被脱敏，即使匹配了任何规则。
  # 支持 *（匹配任意非空字符序列）和 ?（匹配单个非空字符）通配符：
  #   - "*@test.com"      → 排除所有 @test.com 后缀的邮箱
  #   - "192.168.??.*"    → 排除 192.168.xx.xx 网段
  #   - "sk-test-*"       → 排除以 sk-test- 开头的值
  # 不含通配符的字符串按精确匹配处理。
  # 适用于：内网地址、示例域名、测试数据等。
  exclude:
    - "example.com"
    - "localhost"
    - "127.0.0.1"
    - "0.0.0.0"


